@model DEGMA.Models.ImportViewModel

@{
    ViewData["Title"] = "Review Import";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <h2 class="fw-bold text-white mb-1">Review CSV Import</h2>
            <p class="text-muted mb-0">
                Page @Model.CurrentPage of @Model.TotalPages —
                showing rows @((Model.CurrentPage - 1) * ImportViewModel.PageSize + 1)
                to @(Math.Min(Model.CurrentPage * ImportViewModel.PageSize, Model.TotalRows))
            </p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary">Total: @Model.TotalRows</span>
            <span class="badge bg-success">Valid: @(Model.TotalRows - Model.InvalidRows)</span>
            <span class="badge bg-danger">Invalid: @Model.InvalidRows</span>
            <span class="badge bg-warning text-dark">Duplicates: @Model.DuplicateRows</span>
        </div>
    </div>

    @* Single form wraps everything — Save Page button saves edits and moves to next page *@
    <form asp-controller="Import" asp-action="SavePage" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="TempFileId" value="@Model.TempFileId" />
        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />

        @* New Side Effects *@
        @if (Model.NewSideEffectsToCreate.Any())
        {
            <div class="card border-warning mb-3" style="background:#16213e;">
                <div class="card-body py-3">
                    <h6 class="text-warning fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-2"></i>New Side Effects Detected
                    </h6>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @foreach (var se in Model.NewSideEffectsToCreate)
                        {
                            <span class="badge bg-warning text-dark">@se</span>
                            <input type="hidden" name="NewSideEffectsToCreate" value="@se" />
                        }
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input"
                               name="ConfirmNewSideEffects" value="true" id="confirmSE" />
                        <label class="form-check-label text-white" for="confirmSE">
                            Yes, create these side effects automatically
                        </label>
                    </div>
                </div>
            </div>
        }

        @* Duplicate bulk actions *@
        @if (Model.Rows.Any(r => r.IsDuplicate))
        {
            <div class="card mb-3 border-info" style="background:#16213e;">
                <div class="card-body py-2 d-flex align-items-center gap-3 flex-wrap">
                    <span class="text-info fw-bold small text-uppercase">
                        <i class="bi bi-copy me-1"></i>Duplicate Actions (this page):
                    </span>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            onclick="setAllDuplicates('skip')">Skip All</button>
                    <button type="button" class="btn btn-outline-warning btn-sm"
                            onclick="setAllDuplicates('overwrite')">Overwrite All</button>
                    <button type="button" class="btn btn-outline-info btn-sm"
                            onclick="setAllDuplicates('addduplicate')">Add All as Duplicate</button>
                </div>
            </div>
        }

        <!-- Main Table -->
<div class="card shadow-sm border-0 mb-3">
    <div style="overflow-x: auto; overflow-y: auto; max-height: 65vh;">
        <table class="table table-hover align-middle mb-0"
               style="font-size:12px; white-space: nowrap; min-width: 1400px;">
            <thead style="position: sticky; top: 0; z-index: 1; background: var(--bs-dark);">
                <tr>
                    <th class="ps-3">#</th>
                    <th>First Name</th>
                    <th>Surname</th>
                    <th>DOB</th>
                    <th>Email</th>
                    <th>Start Wt</th>
                    <th>Treat. Start</th>
                    <th>Wk</th>
                    <th>Date</th>
                    <th>Weight</th>
                    <th>Dosage</th>
                    <th>Side Effects</th>
                    <th>Notes</th>
                    <th>Status</th>
                    <th>Duplicate</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];
                    var rowClass = !row.IsValid ? "table-danger"
                                 : row.IsDuplicate ? "table-warning" : "";
                    <tr class="@rowClass">
                        <td class="ps-3 text-muted">@(row.RowIndex + 1)</td>
                        <td><input type="text" name="Rows[@i].Firstname" value="@row.Firstname" class="form-control form-control-sm" style="min-width:80px" /></td>
                        <td><input type="text" name="Rows[@i].Surname" value="@row.Surname" class="form-control form-control-sm" style="min-width:80px" /></td>
                        <td><input type="text" name="Rows[@i].DateOfBirth" value="@row.DateOfBirth" class="form-control form-control-sm" style="width:105px" /></td>
                        <td><input type="text" name="Rows[@i].Email" value="@row.Email" class="form-control form-control-sm" style="min-width:140px" /></td>
                        <td><input type="text" name="Rows[@i].StartingWeight" value="@row.StartingWeight" class="form-control form-control-sm" style="width:70px" /></td>
                        <td><input type="text" name="Rows[@i].TreatmentStartDate" value="@row.TreatmentStartDate" class="form-control form-control-sm" style="width:105px" /></td>
                        <td><input type="text" name="Rows[@i].WeekNumber" value="@row.WeekNumber" class="form-control form-control-sm" style="width:50px" /></td>
                        <td><input type="text" name="Rows[@i].Date" value="@row.Date" class="form-control form-control-sm" style="width:105px" /></td>
                        <td><input type="text" name="Rows[@i].Weight" value="@row.Weight" class="form-control form-control-sm" style="width:65px" /></td>
                        <td><input type="text" name="Rows[@i].Dosage" value="@row.Dosage" class="form-control form-control-sm" style="width:65px" /></td>
                        <td><input type="text" name="Rows[@i].SideEffects" value="@row.SideEffects" class="form-control form-control-sm" style="min-width:120px" /></td>
                        <td><input type="text" name="Rows[@i].Notes" value="@row.Notes" class="form-control form-control-sm" style="min-width:140px" /></td>

                        @* Hidden fields *@
                        <input type="hidden" name="Rows[@i].RowIndex" value="@row.RowIndex" />
                        <input type="hidden" name="Rows[@i].WeightChange" value="@row.WeightChange" />
                        <input type="hidden" name="Rows[@i].ExistingPatientId" value="@row.ExistingPatientId" />

                        @* Status column with hover popover for errors *@
                        <td style="min-width: 90px;">
                            @if (!row.IsValid)
                            {
                                var errorList = string.Join("&#10;• ", row.Errors);
                                <span class="text-danger fw-bold"
                                      data-bs-toggle="popover"
                                      data-bs-trigger="hover focus"
                                      data-bs-placement="left"
                                      data-bs-html="true"
                                      data-bs-content="<ul class='mb-0 ps-3' style='font-size:11px;'>@foreach (var err in row.Errors) {<li>@err</li>}</ul>"
                                      style="cursor:help; text-decoration: underline dotted;">
                                    <i class="bi bi-exclamation-circle"></i>
                                    Invalid (@row.Errors.Count)
                                </span>
                            }
                            else if (row.IsDuplicate)
                            {
                                <span class="text-warning">
                                    <i class="bi bi-copy"></i> Duplicate
                                </span>
                            }
                            else
                            {
                                <span class="text-success">
                                    <i class="bi bi-check-circle"></i> OK
                                </span>
                            }
                        </td>

                        @* Duplicate action *@
                        <td style="min-width: 145px;">
                            @if (row.IsDuplicate)
                            {
                                    <select name="Rows[@i].DuplicateAction"
                                            class="form-select form-select-sm duplicate-select"
                                            style="width:140px">
                                        <option value="skip" selected="@(row.DuplicateAction == "skip")">Skip</option>
                                        <option value="overwrite" selected="@(row.DuplicateAction == "overwrite")">Overwrite</option>
                                        <option value="addduplicate" selected="@(row.DuplicateAction == "addduplicate")">Add as Duplicate</option>
                                    </select>
                            }
                            else
                            {
                                <input type="hidden" name="Rows[@i].DuplicateAction" value="none" />
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

        @* Pagination + Actions *@
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div class="d-flex gap-2">
                <a asp-controller="Home" asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
                @if (Model.CurrentPage > 1)
                {
                    <button type="submit" name="nextPage"
                            value="@(Model.CurrentPage - 1)"
                            class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Previous
                    </button>
                }
            </div>

            @* Page numbers *@
            <div class="d-flex gap-1">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <button type="submit" name="nextPage" value="@p"
                            class="btn btn-sm @(p == Model.CurrentPage ? "btn-primary" : "btn-outline-secondary")">
                        @p
                    </button>
                }
            </div>

            <div class="d-flex gap-2">
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <button type="submit" name="nextPage"
                            value="@(Model.CurrentPage + 1)"
                            class="btn btn-outline-primary btn-sm">
                        Next <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                }
                else
                {
                    @* Last page — show Confirm Import *@
                    <button type="submit" name="nextPage" value="0"
                            class="btn btn-success btn-sm px-4 fw-bold">
                        <i class="bi bi-cloud-upload me-1"></i> Confirm Import
                    </button>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
                // Initialise all popovers on the page
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
            new bootstrap.Popover(el, { sanitize: false });
        });
        function setAllDuplicates(action) {
            document.querySelectorAll('.duplicate-select')
                .forEach(sel => sel.value = action);
        }
    </script>
}