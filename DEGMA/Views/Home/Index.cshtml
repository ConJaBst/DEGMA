@model DEGMA.Models.DashboardViewModel
@inject DEGMA.Services.BackupService BackupService

@{
    ViewData["Title"] = "Dashboard";

    string Pct(int count, int of) => of > 0 ? $"{count * 100.0 / of:0}%" : "0%";
    var maxDose = Model.DoseBreakdown.Any() ? Model.DoseBreakdown.Max(d => d.Patients) : 1;
}

<div class="container-fluid px-4 mt-4">
    <h2 class="fw-bold text-white mb-4">Medical Overview</h2>

    <!-- Quick Action Buttons -->
    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <a asp-controller="Patients" asp-action="Create" class="btn btn-primary w-100 py-3 shadow-sm">
                <i class="bi bi-person-plus-fill me-2"></i> Add New Patient
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-primary w-100 py-3 shadow-sm">
                <i class="bi bi-people-fill me-2"></i> Patient Directory
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Reports" asp-action="Create" class="btn btn-success w-100 py-3 shadow-sm text-white">
                <i class="bi bi-file-earmark-plus-fill me-2"></i> Log New Report
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-success w-100 py-3 shadow-sm">
                <i class="bi bi-journal-text me-2"></i> All Reports
            </a>
        </div>
    </div>

    <!-- Headline Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Active Patients</h6>
                    <h1 class="fw-bold mb-0">@Model.ActivePatients</h1>
                    <small class="text-muted">seen in the last 30 days, of @Model.TotalPatients total</small>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Avg. Total Loss</h6>
                    <h1 class="fw-bold mb-0 text-success">
                        @Model.AverageTotalLossKg.ToString("0.0") <small>kg</small>
                    </h1>
                    <small class="text-muted">
                        @Model.AverageTotalLossPercent.ToString("0.0")% of starting weight, per patient
                    </small>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Clinical Milestones</h6>
                    <div class="d-flex gap-4">
                        <div>
                            <h1 class="fw-bold mb-0 text-info">@Pct(Model.ReachedFivePercent, Model.PatientsWithReports)</h1>
                            <small class="text-muted">lost 5%+ (@Model.ReachedFivePercent)</small>
                        </div>
                        <div>
                            <h1 class="fw-bold mb-0 text-info">@Pct(Model.ReachedTenPercent, Model.PatientsWithReports)</h1>
                            <small class="text-muted">lost 10%+ (@Model.ReachedTenPercent)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Visits This Week</h6>
                    <h1 class="fw-bold mb-0">
                        @Model.VisitsThisWeek
                        @if (Model.VisitsChangePercent is double change)
                        {
                            var up = change >= 0;
                            <span class="badge fs-6 align-middle @(up ? "bg-success" : "bg-danger") bg-opacity-25 @(up ? "text-success" : "text-danger")">
                                @(up ? "▲" : "▼") @Math.Abs(change).ToString("0")%
                            </span>
                        }
                    </h1>
                    <small class="text-muted">@Model.VisitsLastWeek the week before</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress curve + Near goal -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold mb-1">Typical Progress</h6>
                    <small class="text-muted d-block mb-3">
                        Average % change from starting weight, by weeks since treatment start
                    </small>
                    @if (Model.ProgressCurve.Any())
                    {
                        <div style="height:280px;"><canvas id="progressChart"></canvas></div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Not enough visits yet to draw a curve.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h6 class="text-muted small text-uppercase fw-bold mb-3">Today</h6>
                    <div id="clockTime" class="fw-bold text-white" style="font-size:3.5rem; line-height:1;">
                        @DateTime.Now.ToString("HH:mm:ss")
                    </div>
                    <div id="clockDate" class="text-muted mt-3 h5 mb-0">
                        @DateTime.Now.ToString("dddd, d MMMM yyyy")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly activity + Doses + Batch -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold mb-1">Monthly Activity</h6>
                    <small class="text-muted d-block mb-3">New patients and visits, last 12 months</small>
                    <div style="height:240px;"><canvas id="activityChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold mb-1">Doses</h6>
                    <small class="text-muted d-block mb-3">Latest dose of each patient</small>
                    @if (!Model.DoseBreakdown.Any())
                    {
                        <p class="text-muted small mb-0">No visits recorded yet.</p>
                    }
                    <div style="max-height:240px; overflow-y:auto;">
                    @foreach (var d in Model.DoseBreakdown)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2 small">
                            <span class="text-nowrap" style="width:64px;">@d.Dosage mg</span>
                            <div class="progress flex-grow-1" style="height:8px; background-color:var(--bg-input);">
                                <div class="progress-bar" style="width:@(d.Patients * 100 / maxDose)%"></div>
                            </div>
                            <span class="fw-bold text-end" style="width:28px;">@d.Patients</span>
                        </div>
                    }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold mb-3">
                        <i class="bi bi-box-seam me-2"></i>Current Batch
                    </h6>
                    <h4 class="fw-bold mb-3">@(string.IsNullOrEmpty(Model.CurrentBatchNumber) ? "Not set" : Model.CurrentBatchNumber)</h4>
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Used from batch</span>
                        <span class="fw-bold">@Model.BatchMgUsed.ToString("0.##") mg</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Doses given</span>
                        <span class="fw-bold">@Model.BatchVisits</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-3">
                        <span class="text-muted">First used</span>
                        <span class="fw-bold">@(Model.BatchFirstUsed?.ToString("dd MMM yyyy") ?? "—")</span>
                    </div>
                    @if (User.IsInRole("Doctor"))
                    {
                        <form asp-controller="Home" asp-action="UpdateBatchNumber" method="post"
                              class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="text" name="batchNumber" required
                                   value="@Model.CurrentBatchNumber"
                                   class="form-control form-control-sm"
                                   placeholder="4YIS2501A" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">
                                <i class="bi bi-save me-1"></i> Update
                            </button>
                        </form>
                    }
                    @if (TempData["BatchSuccess"] != null)
                    {
                        <div class="alert alert-success mt-2 mb-0 py-2 small">
                            <i class="bi bi-check-circle me-1"></i> @TempData["BatchSuccess"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Visits Table -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 p-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-white mb-0">Recent Visits</h5>
                    <a asp-controller="Reports" asp-action="Index" class="small">View all</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Patient</th>
                                <th>Date</th>
                                <th>Weight</th>
                                <th>Change</th>
                                <th>Dosage</th>
                                <th class="text-end pe-4">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model.RecentReports)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">
                                        @report.Patient!.Firstname @report.Patient.Surname
                                    </td>
                                    <td class="text-muted small">@report.Date.ToString("dd MMM yyyy")</td>
                                    <td>@report.Weight kg</td>
                                    <td class="@(report.WeightChange < 0 ? "text-success" : report.WeightChange > 0 ? "text-danger" : "text-muted")">
                                        @(report.WeightChange > 0 ? "+" : "")@report.WeightChange.ToString("0.0") kg
                                    </td>
                                    <td>@report.Dosage mg</td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="Patients"
                                           asp-action="Details"
                                           asp-route-id="@report.PatientId"
                                           class="btn btn-sm btn-outline-secondary py-0">
                                            Profile
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Backup & Restore -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <!-- Two column layout: Backup left, Restore right -->
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted small fw-bold mb-3">
                                <i class="bi bi-download me-2"></i>Data Backup
                            </h6>
                            <form asp-controller="Backup" asp-action="Download"
                                  method="post"
                                  class="d-flex flex-column gap-3">
                                @Html.AntiForgeryToken()
                                <div class="d-flex gap-4 flex-wrap">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="includePrime" id="chkPrime"
                                               value="true" checked />
                                        <label class="form-check-label" for="chkPrime">
                                            Full Backup
                                            <small class="text-muted d-block" style="font-size:10px;">
                                                All reports with patient info
                                            </small>
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="includePatients" id="chkPatients"
                                               value="true" />
                                        <label class="form-check-label" for="chkPatients">
                                            Patients Only
                                            <small class="text-muted d-block" style="font-size:10px;">
                                                Patient records, no reports
                                            </small>
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="includeReports" id="chkReports"
                                               value="true" />
                                        <label class="form-check-label" for="chkReports">
                                            Reports Only
                                            <small class="text-muted d-block" style="font-size:10px;">
                                                Report data, no patient info
                                            </small>
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <button type="submit" class="btn btn-outline-info btn-sm">
                                        <i class="bi bi-download me-1"></i> Download Selected
                                    </button>
                                </div>
                            </form>

                            @* Database backup (local folder + cloud-synced folder) *@
                            @{
                                var lastBackup = BackupService.LastSuccessfulBackup();
                                var cloudFolder = BackupService.CloudFolder;
                            }
                            <h6 class="text-uppercase text-muted small fw-bold mt-4 mb-2">
                                <i class="bi bi-database-check me-2"></i>Database Backup
                            </h6>
                            <small class="text-muted d-block" style="font-size:11px;">
                                Runs daily at @BackupService.DailyTime.ToString("HH:mm").
                                Last backup: @(lastBackup?.ToString("dd MMM yyyy HH:mm") ?? "never")
                            </small>
                            <small class="text-muted d-block mb-2" style="font-size:10px;">
                                Local: @BackupService.LocalFolder<br />
                                Cloud: @(string.IsNullOrEmpty(cloudFolder) ? "not configured" : cloudFolder)
                            </small>
                            <form asp-controller="Backup" asp-action="RunNow" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-cloud-arrow-up me-1"></i> Back Up Now
                                </button>
                            </form>
                            @if (User.IsInRole("Doctor"))
                            {
                                var backups = BackupService.ListBackups();
                                <form asp-controller="Backup" asp-action="ConfirmRestore" method="get"
                                      class="d-flex gap-2 align-items-center mt-2">
                                    <select name="file" class="form-select form-select-sm" style="max-width:320px;"
                                            disabled="@(backups.Count == 0)">
                                        @if (backups.Count == 0)
                                        {
                                            <option>No backups found</option>
                                        }
                                        @foreach (var b in backups)
                                        {
                                            <option value="@b.FileName">
                                                @b.Time.ToString("dd MMM yyyy HH:mm") — @(b.Size / 1024) KB (@string.Join(" + ", b.Locations))
                                            </option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap"
                                            disabled="@(backups.Count == 0)">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restore…
                                    </button>
                                </form>
                            }
                            @if (TempData["BackupSuccess"] != null)
                            {
                                <div class="alert alert-success mt-2 mb-0 py-2 small">
                                    <i class="bi bi-check-circle me-1"></i> @TempData["BackupSuccess"]
                                </div>
                            }
                            @if (TempData["BackupError"] != null)
                            {
                                <div class="alert alert-danger mt-2 mb-0 py-2 small">
                                    <i class="bi bi-x-circle me-1"></i> @TempData["BackupError"]
                                </div>
                            }
                        </div>

                        <div class="col-md-1 d-none d-md-flex justify-content-center">
                            <div class="vr opacity-25"></div>
                        </div>

                        <div class="col-md-5">
                            <h6 class="text-uppercase text-muted small fw-bold mb-3">
                                <i class="bi bi-upload me-2"></i>Restore from CSV
                            </h6>
                            <form asp-controller="Import" asp-action="Upload"
                                  method="post" enctype="multipart/form-data"
                                  class="d-flex flex-column gap-3">
                                @Html.AntiForgeryToken()
                                <div>
                                    <input type="file" name="csvFile" accept=".csv"
                                           class="form-control form-control-sm"
                                           style="max-width:320px;" />
                                    <small class="text-muted d-block mt-1" style="font-size:10px;">
                                        Use a Full Backup CSV file. Large files are processed in pages.
                                    </small>
                                </div>
                                <div>
                                    <button type="submit" class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-upload me-1"></i> Upload & Review
                                    </button>
                                </div>
                            </form>

                            @* Import result alerts *@
                            @if (TempData["ImportSuccess"] != null)
                            {
                                <div class="alert alert-success mt-3 mb-0 py-2 small">
                                    <i class="bi bi-check-circle me-1"></i>
                                    @TempData["ImportSuccess"]
                                </div>
                            }
                            @if (TempData["ImportError"] != null)
                            {
                                <div class="alert alert-danger mt-3 mb-0 py-2 small">
                                    <i class="bi bi-x-circle me-1"></i>
                                    @TempData["ImportError"]
                                </div>
                            }
                            @if (TempData["ImportSkipped"] != null)
                            {
                                <div class="alert alert-warning mt-2 mb-0 py-2 small">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    <strong>@TempData["ImportSkipped"] rows skipped</strong>
                                    due to validation errors:
                                    <ul class="mb-0 mt-1">
                                        @foreach (var detail in System.Text.Json.JsonSerializer
                                            .Deserialize<List<string>>(
                                                TempData["ImportSkippedDetails"]!.ToString()!))
                                        {
                                            <li>@detail</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        (function () {
            const text = '#ced4da', grid = '#373b3e', blue = '#3d8bfd', green = '#198754';
            Chart.defaults.color = text;
            Chart.defaults.borderColor = grid;
            Chart.defaults.font.family = "'Inter', system-ui, -apple-system, sans-serif";

            const curve = @Json.Serialize(Model.ProgressCurve);
            const progressEl = document.getElementById('progressChart');
            if (progressEl && curve.length) {
                new Chart(progressEl, {
                    type: 'line',
                    data: {
                        labels: curve.map(p => 'Wk ' + p.week),
                        datasets: [{
                            label: 'Avg % change',
                            data: curve.map(p => p.averageChangePercent),
                            borderColor: blue,
                            backgroundColor: 'rgba(61,139,253,0.15)',
                            fill: 'origin',
                            tension: 0.3,
                            pointRadius: 2
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: ctx => `${ctx.parsed.y.toFixed(1)}% (${curve[ctx.dataIndex].patients} patients)`
                                }
                            }
                        },
                        scales: {
                            y: { max: 0, ticks: { callback: v => v + '%' } },
                            x: { grid: { display: false }, ticks: { maxTicksLimit: 14 } }
                        }
                    }
                });
            }

            const months = @Json.Serialize(Model.MonthlyActivity);
            new Chart(document.getElementById('activityChart'), {
                type: 'bar',
                data: {
                    labels: months.map(m => m.label),
                    datasets: [
                        { label: 'Visits', data: months.map(m => m.visits), backgroundColor: blue, yAxisID: 'y' },
                        { label: 'New patients', data: months.map(m => m.newPatients), backgroundColor: green, yAxisID: 'y1' }
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } },
                    scales: {
                        y: { beginAtZero: true, position: 'left', title: { display: true, text: 'Visits' } },
                        y1: { beginAtZero: true, position: 'right', grid: { display: false },
                              ticks: { precision: 0 }, title: { display: true, text: 'New patients' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            const timeEl = document.getElementById('clockTime');
            const dateEl = document.getElementById('clockDate');
            function tick() {
                const now = new Date();
                timeEl.textContent = now.toLocaleTimeString('en-GB', { hour12: false });
                dateEl.textContent = now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            }
            tick();
            setInterval(tick, 1000);
        })();
    </script>
}
