@model DEGMA.Models.Report

@{
    ViewData["Title"] = "Edit Report";

    var prevVF = (decimal?)ViewBag.PreviousVisceralFat;
    var prevMM = (decimal?)ViewBag.PreviousMuscleMass;
}

<div class="container-fluid px-5 mt-4" style="max-width: 2000px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="mb-3">
                <h2 class="fw-bold text-warning mb-0">Edit Report</h2>
                <p class="text-muted small">
                    Editing Week @Model.WeekNumber report for
                    <strong class="text-white">@Model.Patient?.Firstname @Model.Patient?.Surname</strong>
                </p>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ReportId" />
                <input type="hidden" asp-for="PatientId" />
                <input type="hidden" asp-for="ReportNumber" />

                @* Row 1: Week, Date, Dosage, Batch Number *@
                <div class="row mb-3">
                    <div class="col-md-2">
                        <label asp-for="WeekNumber" class="form-label fw-bold small text-uppercase"></label>
                        <input asp-for="WeekNumber" class="form-control" readonly />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Date" class="form-label fw-bold small text-uppercase"></label>
                        <input asp-for="Date" class="form-control" type="date"
                               value="@Model.Date.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Dosage" class="form-label fw-bold small text-uppercase">Dosage (mg)</label>
                        <input asp-for="Dosage" class="form-control"
                               value="@Model.Dosage.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <span asp-validation-for="Dosage" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="BatchNumber" class="form-label fw-bold small text-uppercase">Batch Number</label>
                        <input asp-for="BatchNumber" class="form-control"
                               value="@(Model.BatchNumber ?? ViewBag.CurrentBatchNumber ?? "")" />
                        <span class="text-muted small mt-1 d-block" style="font-size:10px;">
                            Edit if this report used a different batch.
                        </span>
                    </div>
                </div>

                @* Row 2: Weight, Weight Change, Original Weight Change, Notes *@
                <div class="row mb-3">
                    <div class="col-md-2">
                        <label asp-for="Weight" class="form-label fw-bold small text-uppercase">Weight (kg)</label>
                        <input asp-for="Weight" class="form-control" id="weightInput"
                               value="@Model.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <span asp-validation-for="Weight" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="WeightChange" class="form-label fw-bold small text-uppercase">Weight Change</label>
                        <input asp-for="WeightChange" class="form-control" id="weightChangeDisplay" readonly
                               value="@Model.WeightChange.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <input type="hidden" id="weightChangeHidden" name="WeightChange"
                               value="@Model.WeightChange.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-uppercase">Original Change</label>
                        <input class="form-control" readonly
                               value="@Model.WeightChange.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) kg"
                               style="color: @(Model.WeightChange <= 0 ? "#28a745" : "#dc3545")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Notes" class="form-label fw-bold small text-uppercase"></label>
                        <input asp-for="Notes" class="form-control"
                               value="@Model.Notes"
                               placeholder="Observation notes..." />
                    </div>
                </div>

                @* Row 3: Visceral Fat, Muscle Mass, Pulse, Blood Pressure *@
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label asp-for="VisceralFat" class="form-label fw-bold small text-uppercase">Visceral Fat (kg)</label>
                        <input asp-for="VisceralFat" id="visceralFatInput" class="form-control"
                               value="@(Model.VisceralFat?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               placeholder="Optional" />
                        <div id="visceralFatWarning" class="text-muted small mt-1" style="display:none;"></div>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MuscleMass" class="form-label fw-bold small text-uppercase">Muscle Mass (kg)</label>
                        <input asp-for="MuscleMass" id="muscleMassInput" class="form-control"
                               value="@(Model.MuscleMass?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               placeholder="Optional" />
                        <div id="muscleMassWarning" class="text-muted small mt-1" style="display:none;"></div>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Pulse" class="form-label fw-bold small text-uppercase">Pulse (bpm)</label>
                        <input asp-for="Pulse" type="number" min="20" max="250" step="1" class="form-control" placeholder="Optional" />
                        <span asp-validation-for="Pulse" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-uppercase" for="SystolicBp">Blood Pressure (mmHg)</label>
                        <div class="input-group">
                            <input asp-for="SystolicBp" type="number" min="50" max="300" step="1"
                                   class="form-control" placeholder="Systolic" aria-label="Systolic" />
                            <span class="input-group-text">/</span>
                            <input asp-for="DiastolicBp" type="number" min="20" max="200" step="1"
                                   class="form-control" placeholder="Diastolic" aria-label="Diastolic" />
                        </div>
                        <span asp-validation-for="SystolicBp" class="text-danger d-block"></span>
                        <span asp-validation-for="DiastolicBp" class="text-danger d-block"></span>
                    </div>
                </div>

                @* Row 4: Side Effects *@
                <div class="mb-3">
                    <partial name="_SideEffectPicker" model="@(ViewBag.SelectedSideEffectIds as IEnumerable<int> ?? Model.SideEffects.Select(s => s.SideEffectId))" />
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-controller="Patients" asp-action="Details"
                       asp-route-id="@Model.PatientId"
                       class="text-decoration-none text-muted">
                        <i class="bi bi-arrow-left"></i> Back to Patient
                    </a>
                    <button type="submit" class="btn btn-warning px-5 fw-bold text-dark">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const originalWeight = @Model.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture);

        document.getElementById('weightInput').addEventListener('input', function() {
            const newWeight = parseFloat(this.value);
            if (isNaN(newWeight)) return;
            const change = (newWeight - originalWeight).toFixed(2);
            document.getElementById('weightChangeDisplay').value = change;
            document.getElementById('weightChangeHidden').value = change;
        });

        const baselineVisceralFat = @(prevVF != null ? prevVF.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        const baselineMuscleMass = @(prevMM != null ? prevMM.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");

        function normalizeVal(v) {
            if (v === null || v === undefined) return '';
            const s = String(v).trim();
            if (s === '') return '';
            const num = parseFloat(s);
            if (isNaN(num)) return '';
            return num.toFixed(2);
        }

        function checkUnchanged(inputId, warningId, baseline) {
            const current = normalizeVal(document.getElementById(inputId).value);
            const base = normalizeVal(baseline);

            const input = document.getElementById(inputId);
            const warning = document.getElementById(warningId);

            if (current === base) {
                input.style.borderColor = '#6c757d';
                warning.textContent = base === '' ? 'Not measured for this patient yet' : 'No change from previous reading';
                warning.style.display = 'block';
            } else {
                input.style.borderColor = '';
                warning.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            checkUnchanged('visceralFatInput', 'visceralFatWarning', baselineVisceralFat);
            checkUnchanged('muscleMassInput', 'muscleMassWarning', baselineMuscleMass);

            document.getElementById('visceralFatInput').addEventListener('input', () =>
                checkUnchanged('visceralFatInput', 'visceralFatWarning', baselineVisceralFat));
            document.getElementById('muscleMassInput').addEventListener('input', () =>
                checkUnchanged('muscleMassInput', 'muscleMassWarning', baselineMuscleMass));
        });
    </script>
}