@model IEnumerable<DEGMA.Models.Report>

@{
    ViewData["Title"] = "Index";
}

<h1>Reports</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<div class="mb-3">
    <button id="toggleBtn" class="btn btn-primary">Show All</button>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.ReportNumber)</th>
                <th>@Html.DisplayNameFor(model => model.WeekNumber)</th>
                <th>@Html.DisplayNameFor(model => model.Weight)</th>
                <th>@Html.DisplayNameFor(model => model.Dosage)</th>
                <th>@Html.DisplayNameFor(model => model.WeightChange)</th>
                <th>@Html.DisplayNameFor(model => model.Notes)</th>
                <th>Patient</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="reportTable">
            @{
                int index = 0;
            }
            @foreach (var item in Model)
            {
                <tr class="report-row @(index >= 10 ? "d-none extra-row" : "")">
                    <td>@item.ReportNumber</td>
                    <td>@item.WeekNumber</td>
                    <td>@item.Weight.ToString("0.00")</td>
                    <td>@item.Dosage.ToString("0.00")</td>
                    <td>@item.WeightChange.ToString("0.00")</td>
                    <td>@item.Notes</td>
                    <td>@(item.Patient?.Firstname + " " + item.Patient?.Surname)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ReportId">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.ReportId">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.ReportId">Delete</a>
                    </td>
                </tr>
                index++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let expanded = false;

        document.getElementById("toggleBtn").addEventListener("click", function () {
            const extraRows = document.querySelectorAll(".extra-row");

            expanded = !expanded;

            extraRows.forEach(row => {
                row.classList.toggle("d-none", !expanded);
            });

            this.textContent = expanded ? "Show Less" : "Show All";
        });
    </script>
}