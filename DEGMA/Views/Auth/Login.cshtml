@model DEGMA.Models.LoginViewModel
@{ Layout = null; }

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DEGMA — Login</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #1a1a2e;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: #16213e;
            border: 1px solid #2a2a4a;
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }
        .login-card h1 {
            font-size: 24px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 4px;
        }
        .login-card .subtitle {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 30px;
        }
        .form-label { color: #adb5bd; font-size: 13px; }
        .form-control {
            background-color: #1a1a2e;
            border: 1px solid #2a2a4a;
            color: #e0e0e0;
        }
        .form-control:focus {
            background-color: #1a1a2e;
            border-color: #3d8bfd;
            color: #e0e0e0;
            box-shadow: 0 0 0 0.2rem rgba(61,139,253,0.15);
        }
        .btn-login {
            background-color: #3d8bfd;
            border: none;
            color: white;
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            font-weight: 600;
        }
        .btn-login:hover { background-color: #2d7ae0; color: white; }
        .alert-danger {
            background-color: rgba(220,53,69,0.15);
            border-color: rgba(220,53,69,0.3);
            color: #f08080;
            font-size: 13px;
        }
        .accent-bar {
            width: 40px;
            height: 3px;
            background: #3d8bfd;
            border-radius: 2px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h1>DEGMA</h1>
        <div class="accent-bar"></div>
        <div class="subtitle">Sign in to access the patient management system.</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false)
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="you@degma.com" />
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
            </div>
            <div class="mb-4 d-flex align-items-center">
                <input asp-for="RememberMe" class="form-check-input me-2" type="checkbox" />
                <label asp-for="RememberMe" class="form-label mb-0">Remember me</label>
            </div>
            <button type="submit" class="btn btn-login">Sign In</button>
        </form>
    </div>
</body>
</html>