@inject DEGMA.Services.UpdateService Updates
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DEGMA</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DEGMA.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom mb-4">
            <div class="container-fluid mx-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DEGMA <span class="text-muted fw-light">Medical</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-medium" asp-controller="Patients" asp-action="Index">Patients</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-medium" asp-controller="Reports" asp-action="Index">Reports</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-medium" asp-controller="SideEffects" asp-action="Index">Side Effects</a>
                        </li>
                    </ul>
                    @if (User.IsInRole("Doctor"))
                    {
                        @* Updates: check GitHub for a newer release, then offer to install it *@
                        <div class="d-flex align-items-center gap-2" id="updateWidget">
                            <span class="small text-muted text-nowrap" id="updateStatus">v@(DEGMA.Services.UpdateService.DisplayVersion)</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" id="updateCheck">
                                Check for updates
                            </button>
                            <form asp-controller="Updates" asp-action="Install" method="post" class="d-none" id="updateInstall">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success text-nowrap" id="updateInstallButton">Update</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    @* Pages can set ViewData["WideLayout"] = true to use more of a wide screen *@
    <div class="@(ViewData["WideLayout"] is true ? "container-fluid px-4" : "container")"
         style="@(ViewData["WideLayout"] is true ? "max-width: 1800px;" : null)">
        <main role="main" class="pb-3">
            @if (User.IsInRole("Doctor") && Updates.Notice is { } notice)
            {
                <div class="alert @(notice.Success ? "alert-success" : "alert-danger") d-flex justify-content-between align-items-center py-2">
                    <span>
                        @if (notice.Success)
                        {
                            <text>DEGMA was updated from v@(notice.From) to v@(notice.To) on @notice.Time.ToString("dd MMM yyyy HH:mm").</text>
                        }
                        else
                        {
                            <text>The update to v@(notice.To) didn't install: @notice.Error</text>
                        }
                    </span>
                    <form asp-controller="Updates" asp-action="Dismiss" method="post" class="ms-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm @(notice.Success ? "btn-outline-success" : "btn-outline-danger")">Dismiss</button>
                    </form>
                </div>
            }
            @if (TempData["UpdateError"] is string updateError)
            {
                <div class="alert alert-danger py-2">@updateError</div>
            }
            @RenderBody()
        </main>
    </div>

   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    @if (User.IsInRole("Doctor"))
    {
        <script>
            (function () {
                const status = document.getElementById('updateStatus');
                const check = document.getElementById('updateCheck');
                const install = document.getElementById('updateInstall');
                const installButton = document.getElementById('updateInstallButton');
                if (!check) return;

                check.addEventListener('click', async () => {
                    check.disabled = true;
                    status.textContent = 'Checking...';
                    status.title = '';
                    try {
                        const res = await fetch('/Updates/Check', { cache: 'no-store' });
                        const r = await res.json();
                        if (r.error) {
                            status.textContent = 'v' + r.currentVersion + ' · check failed';
                            status.title = r.error;
                        } else if (!r.updateAvailable) {
                            status.textContent = 'v' + r.currentVersion + ' · up to date';
                        } else if (r.canInstall) {
                            status.textContent = 'v' + r.currentVersion;
                            installButton.textContent = 'Update to v' + r.latestVersion;
                            install.dataset.version = r.latestVersion;
                            install.classList.remove('d-none');
                            check.classList.add('d-none');
                        } else {
                            status.textContent = 'v' + r.latestVersion + ' available';
                            status.title = r.cannotInstallReason || '';
                        }
                    } catch {
                        status.textContent = 'Update check failed';
                    }
                    check.disabled = false;
                });

                install.addEventListener('submit', (e) => {
                    const ok = confirm('Update DEGMA to v' + install.dataset.version + '?\n\n' +
                        'DEGMA will back up the database, download the update, close, install it and start again. ' +
                        'Anyone using DEGMA will be disconnected for about a minute.');
                    if (!ok) { e.preventDefault(); return; }
                    installButton.disabled = true;
                    installButton.textContent = 'Backing up and downloading...';
                });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
