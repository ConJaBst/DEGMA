@{
    ViewData["Title"] = "Home Page";
}

@model DEGMA.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-4 mt-4">
    <h2 class="fw-bold text-white mb-4">Medical Overview</h2>

    <!-- Quick Action Buttons -->
    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <a asp-controller="Patients" asp-action="Create" class="btn btn-primary w-100 py-3 shadow-sm">
                <i class="bi bi-person-plus-fill me-2"></i> Add New Patient
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-primary w-100 py-3 shadow-sm">
                <i class="bi bi-people-fill me-2"></i> Patient Directory
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Reports" asp-action="Create" class="btn btn-success w-100 py-3 shadow-sm text-white">
                <i class="bi bi-file-earmark-plus-fill me-2"></i> Log New Report
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-success w-100 py-3 shadow-sm">
                <i class="bi bi-journal-text me-2"></i> All Reports
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row g-3">
        <!-- Main 3 Stats -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Unique Patients</h6>
                    <h1 class="fw-bold mb-0">@Model.TotalPatients</h1>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Avg. Weight Loss</h6>
                    <h1 class="fw-bold mb-0 text-success">@Model.AverageWeightLoss.ToString("0.0") <small>kg</small></h1>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Total Reports</h6>
                    <h1 class="fw-bold mb-0">@Model.TotalReports</h1>
                </div>
            </div>
        </div>

        <!-- 5 Additional Stats -->
        <div class="col-md-2">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="card-body p-2">
                    <small class="text-muted d-block">Max Loss</small>
                    <span class="fw-bold text-info h5">@Model.MaxIndividualLoss.ToString("0.0") kg</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="card-body p-2">
                    <small class="text-muted d-block">Common Side Effect</small>
                    <span class="fw-bold h5">@Model.MostCommonSideEffect</span>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="card-body p-2">
                    <small class="text-muted d-block">Total Dosage</small>
                    <span class="fw-bold h5">@Model.TotalDosageAdministered mg</span>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="card-body p-2">
                    <small class="text-muted d-block">Reports (7d)</small>
                    <span class="fw-bold h5">@Model.ReportsThisWeek</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="card-body p-2">
                    <small class="text-muted d-block">Non-Responders</small>
                    <span class="fw-bold text-warning h5">@Model.PatientsWithZeroLoss</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Backup -->
    <div class="row mb-4 mt-3">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">
                        <i class="bi bi-download me-2"></i>Data Backup
                    </h6>
                    <form asp-controller="Backup" asp-action="Download" method="post" class="d-flex align-items-center gap-5 flex-wrap">
                        @Html.AntiForgeryToken()
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="includePrime" id="chkPrime" value="true" checked />
                            <label class="form-check-label" for="chkPrime">
                                Full Backup
                                <small class="text-muted d-block" style="font-size:10px;">All reports with patient info</small>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="includePatients" id="chkPatients" value="true" />
                            <label class="form-check-label" for="chkPatients">
                                Patients Only
                                <small class="text-muted d-block" style="font-size:10px;">Patient records, no reports</small>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="includeReports" id="chkReports" value="true" />
                            <label class="form-check-label" for="chkReports">
                                Reports Only
                                <small class="text-muted d-block" style="font-size:10px;">Report data, no patient info</small>
                            </label>
                        </div>
                        <button type="submit" class="btn btn-outline-info btn-sm ms-auto">
                            <i class="bi bi-download me-1"></i> Download Selected
                        </button>
                    </form>
                    <hr class="border-secondary border-opacity-25 my-3" />

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">
                        <i class="bi bi-upload me-2"></i>Restore from CSV
                    </h6>
                    <form asp-controller="Import" asp-action="Upload" method="post"
                          enctype="multipart/form-data"
                          class="d-flex align-items-center gap-3 flex-wrap">
                        @Html.AntiForgeryToken()
                        <input type="file" name="csvFile" accept=".csv"
                               class="form-control form-control-sm" style="max-width:300px;" />
                        <button type="submit" class="btn btn-outline-warning btn-sm">
                            <i class="bi bi-upload me-1"></i> Upload & Review
                        </button>
                    </form>

                    @if (TempData["ImportSuccess"] != null)
                    {
                        <div class="alert alert-success mt-3 mb-0 py-2 small">
                            <i class="bi bi-check-circle me-1"></i> @TempData["ImportSuccess"]
                        </div>
                    }
                    @if (TempData["ImportError"] != null)
                    {
                        <div class="alert alert-danger mt-3 mb-0 py-2 small">
                            <i class="bi bi-x-circle me-1"></i> @TempData["ImportError"]
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
    <!-- Recent Activity Table -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 p-3">
                    <h5 class="fw-bold text-white mb-0">Recent Activity</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Patient</th>
                                <th>Date</th>
                                <th>Weight</th>
                                <th>Dosage</th>
                                <th class="text-end pe-4">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model.RecentReports)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@report.Patient.Firstname @report.Patient.Surname</td>
                                    <td class="text-muted small">@report.Date.ToShortDateString()</td>
                                    <td>@report.Weight kg</td>
                                    <td>@report.Dosage mg</td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="Patients" asp-action="Details" asp-route-id="@report.PatientId" class="btn btn-sm btn-outline-secondary py-0">Profile</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>