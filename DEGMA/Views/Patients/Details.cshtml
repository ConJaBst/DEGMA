@model DEGMA.Models.Patient
@using System.Globalization

@{
    ViewData["Title"] = "Patient Profile";
    var currentWeight = Model.Reports
    .OrderByDescending(r => r.Date)
    .FirstOrDefault()?.Weight ?? Model.StartingWeight;
    var totalLost = currentWeight - Model.StartingWeight;
    double? toGoal = Model.GoalWeight.HasValue ? currentWeight - Model.GoalWeight.Value : null;
    var reportsAscending = Model.Reports.OrderBy(r => r.Date).ToList();
    bool hasVisceralFat = Model.Reports.Any(r => r.VisceralFat != null);
    bool hasMuscleMass = Model.Reports.Any(r => r.MuscleMass != null);

    var muscleMassReport = Model.Reports
        .Where(r => r.MuscleMass.HasValue)
        .OrderByDescending(r => r.Date)
        .FirstOrDefault();

    decimal? muscleMassPercent = null;
    if (muscleMassReport != null && muscleMassReport.Weight > 0)
        muscleMassPercent = (muscleMassReport.MuscleMass!.Value / (decimal)muscleMassReport.Weight) * 100;

    var visceralFatReport = Model.Reports
        .Where(r => r.VisceralFat.HasValue)
        .OrderByDescending(r => r.Date)
        .FirstOrDefault();

    decimal? visceralFatPercent = null;
    if (visceralFatReport != null && visceralFatReport.Weight > 0)
        visceralFatPercent = (visceralFatReport.VisceralFat!.Value / (decimal)visceralFatReport.Weight) * 100;
}

<div class="container mt-4">

    @* Email / error alerts *@
    @if (TempData["EmailSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["EmailSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["EmailError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-x-circle me-2"></i>@TempData["EmailError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="row mb-4 align-items-end">
        <div class="col-md-7">
            <h1 class="fw-bold text-white mb-0">@Model.Firstname @Model.Surname</h1>
            <p class="text-muted mb-1">Treatment started on @Model.TreatmentStartDate.ToShortDateString()</p>

            @if (muscleMassPercent.HasValue || visceralFatPercent.HasValue)
            {
                <div class="d-flex gap-2 flex-wrap">
                    @if (muscleMassPercent.HasValue)
                    {
                        <span class="badge bg-dark border border-secondary text-light">
                            Muscle Mass: @muscleMassPercent.Value.ToString("0.0", CultureInfo.InvariantCulture)%
                            <span class="text-muted">(as of @muscleMassReport!.Date.ToShortDateString())</span>
                        </span>
                    }
                    @if (visceralFatPercent.HasValue)
                    {
                        <span class="badge bg-dark border border-secondary text-light">
                            Visceral Fat: @visceralFatPercent.Value.ToString("0.0", CultureInfo.InvariantCulture)%
                            <span class="text-muted">(as of @visceralFatReport!.Date.ToShortDateString())</span>
                        </span>
                    }
                </div>
            }
        </div>
        <div class="col-md-5 text-md-end">
            <a asp-action="Edit" asp-route-id="@Model.PatientId"
               class="btn btn-outline-secondary btn-sm">Edit Profile</a>
            <a asp-action="ReportPreview" asp-route-id="@Model.PatientId"
                   class="btn btn-outline-info btn-sm ms-2" target="_blank">
                <i class="bi bi-eye"></i> Preview Report
            </a>
            <a asp-action="DownloadReport" asp-route-id="@Model.PatientId"
                   class="btn btn-outline-light btn-sm ms-2">
                <i class="bi bi-download"></i> Download PDF
            </a>
            <button type="button"
                    class="btn btn-outline-success btn-sm ms-2"
                    onclick="openEmailModal(@Model.PatientId)">
                <i class="bi bi-envelope"></i> Email Report
            </button>
            <a asp-controller="Reports" asp-action="Create"
               asp-route-patientId="@Model.PatientId"
               class="btn btn-primary btn-sm ms-2">+ Log New Entry</a>
        </div>
    </div>

    <div class="row g-3">
        <!-- Sidebar: Patient Info -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Patient Statistics</h6>

                    <div class="mb-3">
                        <label class="text-muted d-block small">Starting Weight</label>
                        <span class="h4">@Model.StartingWeight kg</span>
                    </div>

                    <div class="row mb-3">
                        <div class="col">
                            <label class="text-muted d-block small">Current Weight</label>
                            <span class="h4">@currentWeight kg</span>
                        </div>
                        @if (Model.GoalWeight.HasValue)
                        {
                            <div class="col">
                                <label class="text-muted d-block small">Goal Weight</label>
                                <span class="h4">@Model.GoalWeight kg</span>
                            </div>
                        }
                    </div>

                    <div class="row mb-1">
                        <div class="col">
                            <label class="text-muted d-block small">Total Progress</label>
                            <span class="h4 @(totalLost <= 0 ? "text-success" : "text-danger")">
                                @(totalLost > 0 ? "+" : "")@totalLost.ToString("0.00") kg
                            </span>
                        </div>
                        @if (toGoal.HasValue)
                        {
                            <div class="col">
                                <label class="text-muted d-block small">To Goal</label>
                                @if (toGoal <= 0)
                                {
                                    <span class="h4 text-success">Goal reached</span>
                                }
                                else
                                {
                                    <span class="h4">@toGoal.Value.ToString("0.00") kg</span>
                                }
                            </div>
                        }
                    </div>

                    <hr class="opacity-10" />
                    <p class="small text-muted mb-1">
                        <i class="bi bi-envelope me-2"></i>@Model.Email
                    </p>
                    <p class="small text-muted mb-0">
                        <i class="bi bi-calendar-event me-2"></i>Born @Model.DateOfBirth
                    </p>
                </div>
            </div>
        </div>

        <!-- Graph -->
        <div class="col-md-8">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Weight Progression Curve</h6>
                    <div style="height: 280px; width: 100%;">
                        <canvas id="weightChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Treatment History Table -->
        <div class="col-12 mt-3">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="p-3 border-bottom border-secondary border-opacity-10">
                        <h6 class="text-uppercase text-muted small fw-bold mb-0">Treatment History</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Week</th>
                                    <th>Date</th>
                                    <th>Weight</th>
                                    <th>Change</th>
                                    <th>Dosage</th>
                                    <th>Batch</th>
                                    @if (hasVisceralFat)
                                    {
                                        <th>Visceral Fat</th>
                                    }
                                    @if (hasMuscleMass)
                                    {
                                        <th>Muscle Mass</th>
                                    }
                                    <th>Side Effects</th>
                                    <th>Notes</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in Model.Reports)
                                {
                                    <tr>
                                        <td class="ps-4">Wk @report.WeekNumber</td>
                                        <td class="text-muted small">
                                            @report.Date.ToShortDateString()
                                        </td>
                                        <td class="fw-bold">@report.Weight kg</td>
                                        <td class="@(report.WeightChange <= 0 ? "text-success" : "text-danger")">
                                            @(report.WeightChange > 0 ? "+" : "")@report.WeightChange.ToString("0.00")
                                        </td>
                                        <td>
                                            <span class="badge bg-dark border border-secondary text-info">
                                                @report.Dosage mg
                                            </span>
                                        </td>
                                        <td class="small text-muted">
                                            @(string.IsNullOrEmpty(report.BatchNumber) ? "—" : report.BatchNumber)
                                        </td>
                                        @if (hasVisceralFat)
                                        {
                                            <td class="text-muted">
                                                @(report.VisceralFat.HasValue
                                                    ? report.VisceralFat.Value.ToString("0.00", CultureInfo.InvariantCulture) + " kg"
                                                    : "—")
                                            </td>
                                        }
                                        @if (hasMuscleMass)
                                        {
                                            <td class="text-muted">
                                                @(report.MuscleMass.HasValue
                                                    ? report.MuscleMass.Value.ToString("0.00", CultureInfo.InvariantCulture) + " kg"
                                                    : "—")
                                            </td>
                                        }
                                        <td class="small">
                                            @foreach (var se in report.SideEffects)
                                            {
                                                <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white fw-normal me-1">
                                                    @se.Name
                                                </span>
                                            }
                                        </td>
                                        <td class="small text-muted">
                                            @report.Notes
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-controller="Reports"
                                                   asp-action="Edit"
                                                   asp-route-id="@report.ReportId"
                                                   class="btn btn-sm btn-outline-secondary border-0 me-1">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger border-0"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-report-id="@report.ReportId"
                                                    data-week="@report.WeekNumber">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border border-secondary" style="background-color:#16213e;">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title text-white">Delete Report</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-muted">
                    Are you sure you want to delete
                    <span id="modalWeekLabel" class="text-white fw-bold"></span>?
                    This action cannot be undone.
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Email Confirmation Modal -->
    <div class="modal fade" id="emailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border border-secondary" style="background-color:#16213e;">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-envelope me-2"></i>Email Report
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-muted">
                    <p>This will generate and send the full PDF report to:</p>
                    <p class="text-white fw-bold mb-0" id="emailModalName"></p>
                    <p class="text-info small" id="emailModalEmail"></p>
                    <p class="small mt-2">Are you sure you want to send it?</p>
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <form id="emailForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-send me-1"></i> Send Report
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const ctx = document.getElementById('weightChart').getContext('2d');

        const labels = ['Start', @foreach (var r in reportsAscending) {
        <text>'Wk @r.WeekNumber',</text>
        }
    ];

    const weightData = [
        @Model.StartingWeight.ToString(CultureInfo.InvariantCulture),
        @foreach (var r in reportsAscending)
        {
            <text>@r.Weight.ToString(CultureInfo.InvariantCulture),</text>
        }
    ];

    const datasets = [{
    label: 'Weight (kg)',
    data: weightData,
    borderColor: '#3d8bfd',
    backgroundColor: 'rgba(61, 139, 253, 0.1)',
    borderWidth: 3,
    tension: 0.35,
    fill: true,
    pointRadius: 4,
    pointBackgroundColor: '#3d8bfd',
    yAxisID: 'y'
    }];

    const scales = {
    y: {
    type: 'linear',
    position: 'left',
    beginAtZero: false,
    grid: { color: 'rgba(255, 255, 255, 0.05)' },
    ticks: { color: '#6c757d' }
    },
    x: {
    grid: { display: false },
    ticks: { color: '#6c757d' }
    }
    };

    @if (hasVisceralFat)
    {
        <text>
            const visceralFatData = [
            null,
            @foreach (var r in reportsAscending)
            {
                <text>@(r.VisceralFat.HasValue ? r.VisceralFat.Value.ToString(CultureInfo.InvariantCulture) : "null"),</text>
            }
            ];

            datasets.push({
            label: 'Visceral Fat (kg)',
            data: visceralFatData,
            borderColor: '#f59f00',
            backgroundColor: 'rgba(245, 159, 0, 0.1)',
            borderWidth: 2,
            tension: 0.35,
            fill: false,
            pointRadius: 4,
            pointBackgroundColor: '#f59f00',
            spanGaps: true,
            yAxisID: 'y1'
            });

            scales.y1 = {
            type: 'linear',
            position: 'right',
            beginAtZero: false,
            grid: { drawOnChartArea: false },
            ticks: { color: '#f59f00' }
            };
        </text>
    }

    new Chart(ctx, {
    type: 'line',
    data: { labels: labels, datasets: datasets },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    scales: scales,
    plugins: {
    legend: {
    display: @(hasVisceralFat ? "true" : "false"),
    labels: { color: '#adb5bd' }
    }
    }
    }
    });

    // Delete modal
    document.getElementById('deleteModal').addEventListener('show.bs.modal', function (e) {
    const button = e.relatedTarget;
    const reportId = button.getAttribute('data-report-id');
    const week = button.getAttribute('data-week');

    document.getElementById('modalWeekLabel').textContent = `Week ${week}`;
    document.getElementById('deleteForm').action = `/Reports/Delete/${reportId}`;
    });

    // Email modal
    function openEmailModal(patientId) {
    fetch(`/Patients/EmailReportConfirm/${patientId}`)
    .then(r => r.json())
    .then(data => {
    document.getElementById('emailModalName').textContent  = data.patientName;
    document.getElementById('emailModalEmail').textContent = data.patientEmail;
    document.getElementById('emailForm').action = `/Patients/EmailReport/${patientId}`;
    new bootstrap.Modal(document.getElementById('emailModal')).show();
    });
    }
</script>
}