@model DEGMA.Models.Patient

@{
    Layout = null;
    var currentWeight = Model.Reports.LastOrDefault()?.Weight ?? Model.StartingWeight;
    var totalLost = currentWeight - Model.StartingWeight;
    var isLoss = totalLost <= 0;

    // --- SVG Chart Calculations ---
    var allPoints = new List<(string label, double weight)>();
    allPoints.Add(("Start", Model.StartingWeight));
    foreach (var r in Model.Reports)
    {
        allPoints.Add(($"Wk {r.WeekNumber}", r.Weight));
    }

    int svgWidth = 860;
    int svgHeight = 220;
    int padLeft = 55;
    int padRight = 20;
    int padTop = 20;
    int padBottom = 35;

    double minW = allPoints.Min(p => p.weight) * 0.995;
    double maxW = allPoints.Max(p => p.weight) * 1.005;
    double chartW = svgWidth - padLeft - padRight;
    double chartH = svgHeight - padTop - padBottom;

    double XPos(int i) => padLeft + (allPoints.Count == 1 ? chartW / 2 : i * chartW / (allPoints.Count - 1));
    double YPos(double w) => padTop + chartH - ((w - minW) / (maxW - minW)) * chartH;

    var polyPoints = string.Join(" ", allPoints.Select((p, i) => $"{XPos(i):0.0},{YPos(p.weight):0.0}"));
    var areaPoints = polyPoints
        + $" {XPos(allPoints.Count - 1):0.0},{padTop + chartH:0.0}"
        + $" {XPos(0):0.0},{padTop + chartH:0.0}";

    // Y axis grid lines
    int gridLines = 5;
    var yTicks = Enumerable.Range(0, gridLines + 1)
        .Select(i => minW + i * (maxW - minW) / gridLines)
        .ToList();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: #1a1a2e;
            color: #e0e0e0;
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 13px;
            padding: 40px;
        }

        /* ---- Header ---- */
        .header {
            border-bottom: 2px solid #3d8bfd;
            padding-bottom: 20px;
            margin-bottom: 30px;
            /* table layout for wkhtmltopdf compat */
            display: table;
            width: 100%;
        }
        .header-left  { display: table-cell; vertical-align: top; }
        .header-right { display: table-cell; vertical-align: top; text-align: right; }
        .header h1 { font-size: 26px; font-weight: 700; color: #ffffff; }
        .header .subtitle { color: #6c757d; font-size: 12px; margin-top: 4px; }
        .header .report-meta { color: #6c757d; font-size: 11px; line-height: 1.8; }
        .header .report-meta span { color: #adb5bd; }

        /* ---- Section Title ---- */
        .section-title {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #6c757d;
            font-weight: 700;
            margin-bottom: 12px;
        }

        /* ---- Patient Info Block ---- */
        .info-block {
            background: #16213e;
            border: 1px solid #2a2a4a;
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 30px;
            display: table;
            width: 100%;
        }
        .info-item { display: table-cell; padding-right: 30px; vertical-align: top; }
        .info-item .label {
            font-size: 10px;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 3px;
        }
        .info-item .value { font-size: 13px; color: #e0e0e0; }

        /* ---- Stats Row ---- */
        .stats-row {
            display: table;
            width: 100%;
            margin-bottom: 30px;
            border-spacing: 10px 0;
        }
        .stat-card {
            display: table-cell;
            background: #16213e;
            border: 1px solid #2a2a4a;
            border-radius: 8px;
            padding: 16px 20px;
            width: 25%;
            vertical-align: top;
        }
        .stat-card .label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #6c757d;
            margin-bottom: 6px;
        }
        .stat-card .value { font-size: 22px; font-weight: 700; color: #ffffff; }
        .stat-card .value.success { color: #28a745; }
        .stat-card .value.danger  { color: #dc3545; }

        /* ---- Chart Card ---- */
        .chart-card {
            background: #16213e;
            border: 1px solid #2a2a4a;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
        }

        /* ---- Footer ---- */
        .footer {
            border-top: 1px solid #2a2a4a;
            padding-top: 14px;
            font-size: 10px;
            color: #4a4a6a;
            display: table;
            width: 100%;
        }
        .footer-left  { display: table-cell; }
        .footer-right { display: table-cell; text-align: right; }
    </style>
</head>
<body>

    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <h1>@Model.Firstname @Model.Surname</h1>
            <div class="subtitle">Patient Treatment Report</div>
        </div>
        <div class="header-right">
            <div class="report-meta">
                Generated: <span>@DateTime.Now.ToString("dd MMM yyyy")</span><br />
                Patient ID: <span>#@Model.PatientId</span><br />
                Treatment Start: <span>@Model.TreatmentStartDate.ToShortDateString()</span>
            </div>
        </div>
    </div>

    <!-- Patient Info -->
    <div class="section-title">Patient Information</div>
    <div class="info-block">
        <div class="info-item">
            <div class="label">Full Name</div>
            <div class="value">@Model.Firstname @Model.Surname</div>
        </div>
        <div class="info-item">
            <div class="label">Date of Birth</div>
            <div class="value">@Model.DateOfBirth.ToShortDateString()</div>
        </div>
        <div class="info-item">
            <div class="label">Email Address</div>
            <div class="value">@Model.Email</div>
        </div>
        <div class="info-item">
            <div class="label">Total Reports</div>
            <div class="value">@Model.Reports.Count</div>
        </div>
    </div>

    <!-- Progress Summary -->
    <div class="section-title">Progress Summary</div>
    <div class="stats-row">
        <div class="stat-card">
            <div class="label">Starting Weight</div>
            <div class="value">@Model.StartingWeight.ToString("0.0") kg</div>
        </div>
        <div class="stat-card">
            <div class="label">Current Weight</div>
            <div class="value">@currentWeight.ToString("0.0") kg</div>
        </div>
        <div class="stat-card">
            <div class="label">Total Change</div>
            <div class="value @(isLoss ? "success" : "danger")">
                @(totalLost > 0 ? "+" : "")@totalLost.ToString("0.00") kg
            </div>
        </div>
        <div class="stat-card">
            <div class="label">Weeks in Treatment</div>
            <div class="value">@(Model.Reports.LastOrDefault()?.WeekNumber ?? 0)</div>
        </div>
    </div>

    @{
    // Build the SVG as a C# string to avoid Razor/SVG tag conflicts
    var svgBuilder = new System.Text.StringBuilder();
    svgBuilder.Append($"<svg width=\"100%\" viewBox=\"0 0 {svgWidth} {svgHeight}\" xmlns=\"http://www.w3.org/2000/svg\">");

    // Y axis grid lines and labels
    foreach (var tick in yTicks)
    {
        double y = YPos(tick);
        svgBuilder.Append($"<text x=\"{(padLeft - 6):0.0}\" y=\"{y:0.0}\" fill=\"#6c757d\" font-size=\"10\" text-anchor=\"end\" dominant-baseline=\"middle\">{tick:0.0}</text>");
        svgBuilder.Append($"<line x1=\"{padLeft}\" y1=\"{y:0.0}\" x2=\"{(svgWidth - padRight):0.0}\" y2=\"{y:0.0}\" stroke=\"rgba(255,255,255,0.05)\" stroke-width=\"1\"/>");
    }

    // Area fill
    svgBuilder.Append($"<polygon points=\"{areaPoints}\" fill=\"rgba(61,139,253,0.1)\"/>");

    // Line
    svgBuilder.Append($"<polyline points=\"{polyPoints}\" fill=\"none\" stroke=\"#3d8bfd\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>");

    // Dots, value labels, X axis labels
    for (int i = 0; i < allPoints.Count; i++)
    {
        double x = XPos(i);
        double y = YPos(allPoints[i].weight);

        svgBuilder.Append($"<circle cx=\"{x:0.0}\" cy=\"{y:0.0}\" r=\"4\" fill=\"#3d8bfd\"/>");
        svgBuilder.Append($"<text x=\"{x:0.0}\" y=\"{(y - 10):0.0}\" fill=\"#adb5bd\" font-size=\"9\" text-anchor=\"middle\">{allPoints[i].weight:0.0}</text>");
        svgBuilder.Append($"<text x=\"{x:0.0}\" y=\"{(padTop + chartH + 20):0.0}\" fill=\"#6c757d\" font-size=\"10\" text-anchor=\"middle\">{allPoints[i].label}</text>");
    }

    svgBuilder.Append("</svg>");
}

<!-- Weight Progression Chart -->
<div class="section-title">Weight Progression Curve</div>
<div class="chart-card">
    @Html.Raw(svgBuilder.ToString())
</div>

    <!-- Footer -->
    <div class="footer">
        <div class="footer-left">DEGMA — Confidential Patient Record</div>
        <div class="footer-right">Generated @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</div>
    </div>

</body>
</html>