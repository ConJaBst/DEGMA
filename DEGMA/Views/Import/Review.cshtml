@model DEGMA.Models.ImportViewModel

@{
    ViewData["Title"] = "Review Import";
}

<div class="container-fluid px-4 mt-4">
    <h2 class="fw-bold text-white mb-1">Review CSV Import</h2>
    <p class="text-muted mb-4">Review all rows before importing. Fix any issues highlighted in red.</p>

    <form asp-controller="Import" asp-action="Confirm" method="post">
        @Html.AntiForgeryToken()

        @* New Side Effects Confirmation *@
        @if (Model.NewSideEffectsToCreate.Any())
        {
            <div class="card border-warning mb-4" style="background:#16213e; border-color:#ffc107 !important;">
                <div class="card-body">
                    <h6 class="text-warning fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-2"></i>New Side Effects Detected
                    </h6>
                    <p class="text-muted small mb-3">
                        The following side effects don't exist in the database yet. 
                        Check the box to create them automatically:
                    </p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var se in Model.NewSideEffectsToCreate)
                        {
                            <span class="badge bg-warning text-dark">@se</span>
                        }
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" 
                               name="ConfirmNewSideEffects" value="true" id="confirmSE" />
                        <label class="form-check-label text-white" for="confirmSE">
                            Yes, create these side effects automatically
                        </label>
                    </div>
                </div>
            </div>
        }

        @* Duplicate Actions Bulk Buttons *@
        @if (Model.Rows.Any(r => r.IsDuplicate))
        {
            <div class="card mb-4 border-info" style="background:#16213e;">
                <div class="card-body d-flex align-items-center gap-3 flex-wrap">
                    <span class="text-info fw-bold small text-uppercase">
                        <i class="bi bi-copy me-1"></i>Duplicate Actions (All):
                    </span>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            onclick="setAllDuplicates('skip')">Skip All Duplicates</button>
                    <button type="button" class="btn btn-outline-warning btn-sm"
                            onclick="setAllDuplicates('overwrite')">Overwrite All</button>
                    <button type="button" class="btn btn-outline-info btn-sm"
                            onclick="setAllDuplicates('addduplicate')">Add All as Duplicate</button>
                </div>
            </div>
        }

        @* Stats Bar *@
        <div class="d-flex gap-4 mb-3">
            <span class="text-muted small">
                Total: <strong class="text-white">@Model.Rows.Count</strong>
            </span>
            <span class="text-muted small">
                Valid: <strong class="text-success">@Model.Rows.Count(r => r.IsValid)</strong>
            </span>
            <span class="text-muted small">
                Invalid: <strong class="text-danger">@Model.Rows.Count(r => !r.IsValid)</strong>
            </span>
            <span class="text-muted small">
                Duplicates: <strong class="text-warning">@Model.Rows.Count(r => r.IsDuplicate)</strong>
            </span>
        </div>

        @* Main Table *@
        <div class="card shadow-sm border-0 mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:12px;">
                    <thead>
                        <tr>
                            <th class="ps-3">#</th>
                            <th>First Name</th>
                            <th>Surname</th>
                            <th>DOB</th>
                            <th>Email</th>
                            <th>Start Weight</th>
                            <th>Wk</th>
                            <th>Date</th>
                            <th>Weight</th>
                            <th>Dosage</th>
                            <th>Side Effects</th>
                            <th>Notes</th>
                            <th>Status</th>
                            <th>Duplicate Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Rows.Count; i++)
                        {
                            var row = Model.Rows[i];
                            var rowClass = !row.IsValid ? "table-danger" : row.IsDuplicate ? "table-warning" : "";

                            <tr class="@rowClass">
                                <td class="ps-3 text-muted">@(row.RowIndex + 1)</td>

                                <td><input type="text" name="Rows[@i].Firstname"
                                     value="@row.Firstname" class="form-control form-control-sm" /></td>
                                <td><input type="text" name="Rows[@i].Surname"
                                     value="@row.Surname" class="form-control form-control-sm" /></td>
                                <td><input type="text" name="Rows[@i].DateOfBirth"
                                     value="@row.DateOfBirth" class="form-control form-control-sm" style="width:105px" /></td>
                                <td><input type="text" name="Rows[@i].Email"
                                     value="@row.Email" class="form-control form-control-sm" /></td>
                                <td><input type="text" name="Rows[@i].StartingWeight"
                                     value="@row.StartingWeight" class="form-control form-control-sm" style="width:80px" /></td>
                                <td><input type="text" name="Rows[@i].WeekNumber"
                                     value="@row.WeekNumber" class="form-control form-control-sm" style="width:55px" /></td>
                                <td><input type="text" name="Rows[@i].Date"
                                     value="@row.Date" class="form-control form-control-sm" style="width:105px" /></td>
                                <td><input type="text" name="Rows[@i].Weight"
                                     value="@row.Weight" class="form-control form-control-sm" style="width:70px" /></td>
                                <td><input type="text" name="Rows[@i].Dosage"
                                     value="@row.Dosage" class="form-control form-control-sm" style="width:70px" /></td>
                                <td><input type="text" name="Rows[@i].SideEffects"
                                     value="@row.SideEffects" class="form-control form-control-sm" /></td>
                                <td><input type="text" name="Rows[@i].Notes"
                                     value="@row.Notes" class="form-control form-control-sm" /></td>

                                @* Hidden fields *@
                                <input type="hidden" name="Rows[@i].RowIndex" value="@row.RowIndex" />
                                <input type="hidden" name="Rows[@i].WeightChange" value="@row.WeightChange" />
                                <input type="hidden" name="Rows[@i].ReportNumber" value="@row.ReportNumber" />
                                <input type="hidden" name="Rows[@i].TreatmentStartDate" value="@row.TreatmentStartDate" />
                                <input type="hidden" name="Rows[@i].ExistingPatientId" value="@row.ExistingPatientId" />

                                @* Status column *@
                                <td>
                                    @if (!row.IsValid)
                                    {
                                        <span class="text-danger fw-bold" title="@string.Join(", ", row.Errors)">
                                            <i class="bi bi-exclamation-circle"></i> Invalid
                                        </span>
                                        <div class="text-danger" style="font-size:10px;">
                                            @foreach (var err in row.Errors)
                                            {
                                                <div>• @err</div>
                                            }
                                        </div>
                                    }
                                    else if (row.IsDuplicate)
                                    {
                                        <span class="text-warning">
                                            <i class="bi bi-copy"></i> Duplicate
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-check-circle"></i> OK
                                        </span>
                                    }
                                </td>

                                @* Duplicate action selector *@
                                <td>
                                    @if (row.IsDuplicate)
                                    {
                                        <select name="Rows[@i].DuplicateAction"
                                                class="form-select form-select-sm duplicate-select"
                                                style="width:140px">
                                            <option value="skip" selected="@(row.DuplicateAction == "skip")">Skip</option>
                                            <option value="overwrite" selected="@(row.DuplicateAction == "overwrite")">Overwrite</option>
                                            <option value="addduplicate" selected="@(row.DuplicateAction == "addduplicate")">Add as Duplicate</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="hidden" name="Rows[@i].DuplicateAction" value="none" />
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Hidden fields for NewSideEffectsToCreate *@
        @for (int i = 0; i < Model.NewSideEffectsToCreate.Count; i++)
        {
            <input type="hidden" name="NewSideEffectsToCreate[@i]" value="@Model.NewSideEffectsToCreate[i]" />
        }

        @* Action Buttons *@
        <div class="d-flex justify-content-between align-items-center mb-5">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-success px-5 fw-bold">
                <i class="bi bi-cloud-upload me-1"></i> Confirm Import
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function setAllDuplicates(action) {
            document.querySelectorAll('.duplicate-select').forEach(sel => {
                sel.value = action;
            });
        }
    </script>
}