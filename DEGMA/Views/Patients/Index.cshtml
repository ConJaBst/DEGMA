@model IEnumerable<DEGMA.Models.Patient>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Patient Directory</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Patient</a>
    </div>

    @* Search Bar *@
    <form asp-action="Index" method="get" class="mb-3 d-flex gap-2">
        <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Search by name or date of birth..." />
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </form>

    <div class="card p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">
                            <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["NameSortParam"]"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   class="text-decoration-none text-reset">
                                Patient Name
                                @if (ViewData["CurrentSort"]?.ToString() == "name")
                                {
                                    <span>▲</span>
                                }
                                else if (ViewData["CurrentSort"]?.ToString() == "name_desc")
                                {

                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th>Email</th>
                        <th>
                            <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["AgeSortParam"]"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   class="text-decoration-none text-reset">
                                Date of Birth
                                @if (ViewData["CurrentSort"]?.ToString() == "age")
                                {
                                    <span>▲</span>
                                }
                                else if (ViewData["CurrentSort"]?.ToString() == "age_desc")
                                {

                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["WeightSortParam"]"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   class="text-decoration-none text-reset">
                                Starting Weight
                                @if (ViewData["CurrentSort"]?.ToString() == "weight")
                                {
                                    <span>▲</span>
                                }
                                else if (ViewData["CurrentSort"]?.ToString() == "weight_desc")
                                {

                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["RecentSortParam"]"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   class="text-decoration-none text-reset">
                                Recent Input
                                @if (ViewData["CurrentSort"]?.ToString() == "recent")
                                {
                                    <span>▲</span>
                                }
                                else if (ViewData["CurrentSort"]?.ToString() == "recent_desc")
                                {

                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">@item.Firstname @item.Surname</td>
                            <td>@item.Email</td>
                            <td>@item.DateOfBirth</td>
                            <td>@item.StartingWeight kg</td>
                            <td>
                                @{
                                    var latestReport = item.Reports.OrderByDescending(r => r.Date).FirstOrDefault();
                                }
                                @(latestReport != null ? latestReport.Date.ToString() : "No reports yet")
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.PatientId"
                                   class="btn btn-sm btn-outline-secondary border-0">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.PatientId"
                                   class="btn btn-sm btn-outline-primary border-0">Profile</a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger border-0"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deletePatientModal"
                                        data-patient-id="@item.PatientId"
                                        data-patient-name="@item.Firstname @item.Surname">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deletePatientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-secondary" style="background-color:#16213e;">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <h5 class="modal-title text-white">Delete Patient</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-muted">
                Are you sure you want to delete
                <span id="deletePatientName" class="text-white fw-bold"></span>?
                This will permanently delete the patient and
                <strong class="text-danger">all of their reports</strong>.
                This action cannot be undone.
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <form id="deletePatientForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">
                        Delete Patient
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deletePatientModal').addEventListener('show.bs.modal', function (e) {
            const button = e.relatedTarget;
            const patientId = button.getAttribute('data-patient-id');
            const patientName = button.getAttribute('data-patient-name');

            document.getElementById('deletePatientName').textContent = patientName;
            document.getElementById('deletePatientForm').action = `/Patients/Delete/${patientId}`;
        });
    </script>
}