@model DEGMA.Models.Patient

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Patient</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Firstname)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Firstname)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Surname)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Surname)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateOfBirth)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateOfBirth)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartingWeight)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartingWeight)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.PatientId">Edit</a> |
    <h4>Medical History (Reports)</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Week</th>
                <th>Weight</th>
                <th>Dosage</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model.Reports.OrderByDescending(r => r.WeekNumber))
            {
                <tr>
                    <td>@report.WeekNumber</td>
                    <td>@report.Weight kg</td>
                    <td>@report.Dosage mg</td>
                    <td>@report.Notes</td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index">Back to List</a>
</div>
